# =====================================================================
# SwiftChat - Git Exclusion Rules
# =====================================================================

# Environment and Secrets (Never commit actual credentials)
**/.env
**/.env.*
!**/.env.example
*.secret
*.pem
*.key

# Maven / Java Build Artifacts
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/*.nar

# Java / JVM Crash & Diagnostic Logs
hs_err_pid*
replay_pid*

# IDE and Editor Files
.idea/
*.iml
.vscode/
.project
.classpath
.settings/
*.sublime-*
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Node / React Native / Expo
**/node_modules/
**/.expo/
.expo-shared/
**/dist/
**/web-build/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
*.metro.log

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
