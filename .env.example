# =====================================================================
# SwiftChat - Environment Variables Configuration Template
# Duplicate this file as .env and populate with your environment specifics.
# DO NOT commit the .env file containing credentials to source control.
# =====================================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=swiftchat_db
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Backend Server Configuration (Apache Tomcat 10.1)
SERVER_PORT=8080
APP_CONTEXT=swiftchat-backend

# Frontend API Configuration (Android Emulator connects via 10.0.2.2)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/swiftchat-backend
EXPO_PUBLIC_WS_BASE_URL=ws://10.0.2.2:8080/swiftchat-backend/ws/chat
